  title = {{Verletzungsprophylaxe im Leistungssport: Spezifische Trainingseffekte auf biomechanische Risikofaktoren von Kreuzbandverletzungen}},
  shorttitle = {{Verletzungsprophylaxe im Leistungssport}},
