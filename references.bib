@article{Blaschova2024,
  title = {{{STRATEGIES FOR A SELF-SELECTED UNANTICIPATED CHANGE OF DIRECTION MANEUVER AND THE RISK FOR ACL INJURY}}: {{FINDINGS FROM HAIE STUDY}}},
  shorttitle = {{{STRATEGIES FOR A SELF-SELECTED UNANTICIPATED CHANGE OF DIRECTION MANEUVER AND THE RISK FOR ACL INJURY}}},
  author = {Blaschova, Denisa and Janda{\v c}ka, Daniel and Zahradnik, David and Hamill, Joseph},
  year = 2024,
