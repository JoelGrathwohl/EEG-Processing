  author = {Mai, Patrick and Willwacher, Steffen and Rahlf, Lina and Hoenig, Tim and Braun, Luca and {von Diecken}, Carlo and Bill, Kevin and Fohrmann, Dominik and Krosshaug, Tron and Hollander, Karsten and Gronwald, Thomas and Wilke, Jan},
